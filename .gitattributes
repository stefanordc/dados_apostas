# Normaliza tudo para LF no repositório
* text=auto eol=lf

# Scripts Windows mantêm CRLF (obrigatório para .ps1/.bat/.cmd)
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binários (não mexer)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.xlsx binary
*.db   binary
*.sqlite3 binary

# Linguagens específicas
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.css  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf